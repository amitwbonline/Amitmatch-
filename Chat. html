<!DOCTYPE html>
<html lang="bn">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Amit Match - Chat</title>

<style>
*{
  box-sizing:border-box;
}

body{
  margin:0;
  font-family:Arial, sans-serif;
  background:#fff4f8;
  color:#29252d;
}

.header{
  background:linear-gradient(135deg,#f72570,#a92bb8);
  color:white;
  padding:18px 12px;
  text-align:center;
  box-shadow:0 3px 12px rgba(0,0,0,.15);
}

.logo{
  font-size:34px;
  font-weight:bold;
  margin-bottom:15px;
}

.nav{
  display:flex;
  justify-content:center;
  flex-wrap:wrap;
  gap:10px;
}

.nav a{
  text-decoration:none;
  color:white;
  background:rgba(255,255,255,.18);
  padding:12px 20px;
  border-radius:30px;
  font-size:17px;
}

.nav a:hover{
  background:white;
  color:#e51b70;
}

.chat-box{
  max-width:700px;
  margin:15px auto;
  background:white;
  min-height:calc(100vh - 150px);
  border-radius:18px;
  box-shadow:0 3px 15px rgba(0,0,0,.12);
  display:flex;
  flex-direction:column;
  overflow:hidden;
}

.chat-title{
  padding:18px;
  background:linear-gradient(135deg,#f72570,#b52ab8);
  color:white;
  font-size:23px;
  font-weight:bold;
  text-align:center;
}

.person{
  padding:15px;
  border-bottom:1px solid #eee;
  font-size:18px;
  font-weight:bold;
  text-align:center;
}

#messages{
  flex:1;
  padding:15px;
  overflow-y:auto;
  min-height:400px;
}

.message{
  max-width:75%;
  padding:11px 15px;
  margin:8px 0;
  border-radius:18px;
  font-size:16px;
  line-height:1.5;
  word-wrap:break-word;
}

.received{
  background:#f0f0f0;
  margin-right:auto;
  border-bottom-left-radius:5px;
}

.sent{
  background:#e91e73;
  color:white;
  margin-left:auto;
  border-bottom-right-radius:5px;
}

.time{
  display:block;
  font-size:11px;
  opacity:.65;
  margin-top:4px;
}

.empty{
  text-align:center;
  color:#888;
  padding:80px 20px;
  font-size:18px;
}

.input-area{
  display:flex;
  gap:8px;
  padding:12px;
  border-top:1px solid #eee;
  background:#fff;
}

#messageInput{
  flex:1;
  border:1px solid #ddd;
  border-radius:25px;
  padding:13px 17px;
  font-size:16px;
  outline:none;
}

#messageInput:focus{
  border-color:#e91e73;
}

#sendBtn{
  border:none;
  background:linear-gradient(135deg,#f72570,#a92bb8);
  color:white;
  border-radius:25px;
  padding:0 22px;
  font-size:16px;
  font-weight:bold;
  cursor:pointer;
}

#sendBtn:active{
  transform:scale(.97);
}

.login-box{
  text-align:center;
  padding:70px 20px;
}

.login-box h2{
  color:#e91e73;
}

.login-box button{
  border:none;
  background:#e91e73;
  color:white;
  padding:12px 25px;
  border-radius:25px;
  font-size:16px;
}

@media(max-width:600px){

  .logo{
    font-size:30px;
  }

  .nav a{
    padding:10px 15px;
    font-size:15px;
  }

  .chat-box{
    margin:0;
    border-radius:0;
    min-height:calc(100vh - 135px);
  }

  .message{
    max-width:85%;
  }

  #sendBtn{
    padding:0 17px;
  }
}
</style>
</head>

<body>

<header class="header">

  <div class="logo">💖 Amit Match</div>

  <nav class="nav">
    <a href="index.html">Home</a>
    <a href="index.html">🔎 Search</a>
    <a href="index.html">👤 My Profile</a>
    <a href="index.html">💕 Matches</a>
    <a href="index.html">Logout</a>
  </nav>

</header>


<div class="chat-box">

  <div class="chat-title">
    💬 Chat
  </div>

  <div class="person" id="personName">
    👤 Chat with your Match
  </div>

  <div id="messages">

    <div class="empty" id="emptyMessage">
      💕 আপনার Match-এর সাথে কথা বলুন<br><br>
      নিচে মেসেজ লিখে Send করুন।
    </div>

  </div>

  <div class="input-area">

    <input
      type="text"
      id="messageInput"
      placeholder="মেসেজ লিখুন..."
      autocomplete="off"
    >

    <button id="sendBtn">
      Send
    </button>

  </div>

</div>


<script type="module">

/* Firebase */
import { initializeApp }
from "https://www.gstatic.com/firebasejs/10.12.2/firebase-app.js";

import {
  getAuth,
  onAuthStateChanged
}
from "https://www.gstatic.com/firebasejs/10.12.2/firebase-auth.js";

import {
  getFirestore,
  collection,
  addDoc,
  query,
  orderBy,
  onSnapshot,
  serverTimestamp
}
from "https://www.gstatic.com/firebasejs/10.12.2/firebase-firestore.js";


/* Firebase configuration */

const firebaseConfig = {
  apiKey: "AIzaSyAHKG7uIA3oQK5Syfq96xJW-lKbjihswl4",
  authDomain: "amit-match.firebaseapp.com",
  projectId: "amit-match",
  storageBucket: "amit-match.firebasestorage.app",
  messagingSenderId: "128100464896",
  appId: "1:128100464896:web:471c7a89502d1a6a679be5",
  measurementId: "G-F1P824DE41"
};


/* Firebase start */

const app = initializeApp(firebaseConfig);

const auth = getAuth(app);

const db = getFirestore(app);


/* HTML elements */

const messagesBox =
  document.getElementById("messages");

const input =
  document.getElementById("messageInput");

const sendBtn =
  document.getElementById("sendBtn");

const personName =
  document.getElementById("personName");

const emptyMessage =
  document.getElementById("emptyMessage");


let currentUser = null;


/* Check login */

onAuthStateChanged(auth, (user) => {

  if(user){

    currentUser = user;

    personName.innerHTML =
      "👤 Chatting as: " +
      (user.email || "User");

    loadMessages();

  }else{

    personName.innerHTML =
      "⚠️ আগে Login করুন";

  }

});


/* Load messages */

function loadMessages(){

  const messagesRef =
    collection(db, "messages");

  const q =
    query(
      messagesRef,
      orderBy("createdAt", "asc")
    );

  onSnapshot(q, (snapshot) => {

    messagesBox.innerHTML = "";

    if(snapshot.empty){

      messagesBox.innerHTML = `
        <div class="empty">
          💕 এখনো কোনো মেসেজ নেই।<br><br>
          প্রথম মেসেজটি আপনি পাঠান।
        </div>
      `;

      return;
    }


    snapshot.forEach((doc) => {

      const data = doc.data();

      const div =
        document.createElement("div");

      const isMine =
        currentUser &&
        data.uid === currentUser.uid;

      div.className =
        "message " +
        (isMine ? "sent" : "received");


      const text =
        document.createElement("span");

      text.textContent =
        data.text || "";


      const time =
        document.createElement("span");

      time.className = "time";

      if(data.createdAt){

        try{

          const date =
            data.createdAt.toDate();

          time.textContent =
            date.toLocaleTimeString(
              "bn-BD",
              {
                hour:"2-digit",
                minute:"2-digit"
              }
            );

        }catch(e){

          time.textContent = "";

        }

      }


      div.appendChild(text);

      div.appendChild(time);

      messagesBox.appendChild(div);

    });


    messagesBox.scrollTop =
      messagesBox.scrollHeight;

  });

}


/* Send message */

async function sendMessage(){

  const text =
    input.value.trim();


  if(!text){

    return;

  }


  if(!currentUser){

    alert("আগে Login করুন।");

    return;

  }


  sendBtn.disabled = true;

  try{

    await addDoc(
      collection(db, "messages"),
      {
        uid: currentUser.uid,
        email: currentUser.email || "",
        text: text,
        createdAt: serverTimestamp()
      }
    );

    input.value = "";

    input.focus();

  }catch(error){

    console.error(error);

    alert(
      "Message পাঠানো যায়নি। Firebase Rules পরীক্ষা করুন।"
    );

  }

  sendBtn.disabled = false;

}


/* Button */

sendBtn.addEventListener(
  "click",
  sendMessage
);


/* Enter key */

input.addEventListener(
  "keydown",
  (event) => {

    if(event.key === "Enter"){

      event.preventDefault();

      sendMessage();

    }

  }
);

</script>

</body>
</html>
