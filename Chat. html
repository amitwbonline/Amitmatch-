<!DOCTYPE html>
<html lang="bn">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <title>Amit Match - Chat</title>

  <style>
    * {
      box-sizing: border-box;
    }

    body {
      margin: 0;
      font-family: Arial, sans-serif;
      background: #fff4f8;
      color: #292735;
    }

    /* HEADER */
    .header {
      background: linear-gradient(135deg, #ec1970, #a52bb8);
      color: white;
      padding: 18px 15px;
      position: sticky;
      top: 0;
      z-index: 10;
      box-shadow: 0 3px 12px rgba(0,0,0,.15);
    }

    .header-top {
      display: flex;
      align-items: center;
      gap: 12px;
      max-width: 700px;
      margin: auto;
    }

    .back {
      border: none;
      background: rgba(255,255,255,.2);
      color: white;
      font-size: 27px;
      width: 45px;
      height: 45px;
      border-radius: 50%;
      cursor: pointer;
    }

    .person-info {
      flex: 1;
    }

    .person-name {
      font-size: 21px;
      font-weight: bold;
    }

    .status {
      font-size: 13px;
      opacity: .85;
      margin-top: 3px;
    }

    /* CHAT BOX */
    .chat-box {
      max-width: 700px;
      margin: auto;
      background: white;
      min-height: calc(100vh - 145px);
      display: flex;
      flex-direction: column;
    }

    #messages {
      flex: 1;
      padding: 18px 14px 100px;
      overflow-y: auto;
    }

    .welcome {
      text-align: center;
      color: #888;
      padding: 40px 20px;
      font-size: 15px;
    }

    .message-row {
      display: flex;
      margin: 8px 0;
    }

    .message-row.me {
      justify-content: flex-end;
    }

    .message-row.other {
      justify-content: flex-start;
    }

    .message {
      max-width: 78%;
      padding: 10px 14px;
      border-radius: 18px;
      font-size: 16px;
      line-height: 1.4;
      word-wrap: break-word;
    }

    .me .message {
      background: linear-gradient(135deg, #ed1970, #b326b6);
      color: white;
      border-bottom-right-radius: 5px;
    }

    .other .message {
      background: #eeeeF4;
      color: #222;
      border-bottom-left-radius: 5px;
    }

    .time {
      font-size: 10px;
      opacity: .7;
      margin-top: 4px;
      text-align: right;
    }

    /* INPUT */
    .input-area {
      position: fixed;
      bottom: 0;
      left: 0;
      right: 0;
      background: white;
      border-top: 1px solid #ddd;
      padding: 10px;
      z-index: 20;
    }

    .input-inner {
      max-width: 700px;
      margin: auto;
      display: flex;
      gap: 8px;
    }

    #messageInput {
      flex: 1;
      border: 1px solid #ddd;
      border-radius: 25px;
      padding: 13px 17px;
      font-size: 16px;
      outline: none;
      background: #f7f7f9;
    }

    #messageInput:focus {
      border-color: #e52a82;
      background: white;
    }

    #sendBtn {
      width: 52px;
      height: 52px;
      border: none;
      border-radius: 50%;
      background: linear-gradient(135deg, #ed1970, #a52bb8);
      color: white;
      font-size: 22px;
      cursor: pointer;
    }

    #sendBtn:disabled {
      opacity: .5;
    }

    /* LOGIN / ERROR */
    .notice {
      max-width: 650px;
      margin: 40px auto;
      padding: 25px;
      text-align: center;
      background: white;
      border-radius: 18px;
      box-shadow: 0 3px 15px rgba(0,0,0,.08);
    }

    .notice h2 {
      color: #d92376;
    }

    .notice button {
      border: none;
      background: #e91e73;
      color: white;
      padding: 12px 22px;
      border-radius: 25px;
      font-size: 15px;
      margin-top: 12px;
      cursor: pointer;
    }

    .loading {
      text-align: center;
      padding: 40px;
      color: #888;
    }
  </style>
</head>

<body>

  <!-- HEADER -->
  <div class="header">
    <div class="header-top">

      <button class="back" onclick="goBack()">‹</button>

      <div class="person-info">
        <div class="person-name" id="personName">
          Chat
        </div>

        <div class="status" id="status">
          Connecting...
        </div>
      </div>

    </div>
  </div>


  <!-- CHAT -->
  <div class="chat-box">

    <div id="messages">

      <div class="loading" id="loading">
        Chat loading...
      </div>

    </div>

  </div>


  <!-- MESSAGE INPUT -->
  <div class="input-area">

    <div class="input-inner">

      <input
        id="messageInput"
        type="text"
        placeholder="মেসেজ লিখুন..."
        autocomplete="off"
      >

      <button id="sendBtn">
        ➤
      </button>

    </div>

  </div>


  <!-- FIREBASE -->
  <script type="module">

    import { initializeApp } from
      "https://www.gstatic.com/firebasejs/12.3.0/firebase-app.js";

    import {
      getAuth,
      onAuthStateChanged
    } from
      "https://www.gstatic.com/firebasejs/12.3.0/firebase-auth.js";

    import {
      getFirestore,
      collection,
      addDoc,
      query,
      orderBy,
      onSnapshot,
      serverTimestamp
    } from
      "https://www.gstatic.com/firebasejs/12.3.0/firebase-firestore.js";


    /* =========================
       FIREBASE CONFIG
    ========================= */

    const firebaseConfig = {

      apiKey: "AIzaSyAHKG7uIA3oQK5Syfq96xJW-lKbjihswl4",

      authDomain: "amit-match.firebaseapp.com",

      projectId: "amit-match",

      storageBucket: "amit-match.firebasestorage.app",

      messagingSenderId: "128100464896",

      appId: "1:128100464896:web:471c7a89502d1a6a679be5",

      measurementId: "G-F1P824DE41"

    };


    /* =========================
       INITIALIZE FIREBASE
    ========================= */

    const app = initializeApp(firebaseConfig);

    const auth = getAuth(app);

    const db = getFirestore(app);


    /* =========================
       GET CHAT PARTNER
       
       Example:
       Chat.html?uid=ABC123&name=Rahul
    ========================= */

    const params = new URLSearchParams(window.location.search);

    const partnerUid = params.get("uid");

    const partnerName =
      params.get("name") || "Amit Match User";


    document.getElementById("personName").textContent =
      partnerName;


    /* =========================
       VARIABLES
    ========================= */

    let currentUser = null;

    let chatId = null;

    let unsubscribeMessages = null;


    /* =========================
       CREATE CHAT ID
       
       Same two users always get
       the same chat room.
    ========================= */

    function makeChatId(uid1, uid2) {

      return [uid1, uid2]
        .sort()
        .join("_");

    }


    /* =========================
       BACK BUTTON
    ========================= */

    window.goBack = function() {

      if (document.referrer) {

        history.back();

      } else {

        window.location.href = "index.html";

      }

    };


    /* =========================
       AUTH CHECK
    ========================= */

    onAuthStateChanged(auth, (user) => {

      if (!user) {

        showNotice(
          "Login required",
          "Chat করার জন্য আগে আপনার Amit Match account-এ Login করুন।"
        );

        document.getElementById("status").textContent =
          "Not logged in";

        return;

      }


      currentUser = user;


      /* No partner selected */

      if (!partnerUid) {

        showNotice(
          "Chat user পাওয়া যায়নি",
          "কোন user-এর সাথে chat করবেন তার UID পাওয়া যায়নি।"
        );

        document.getElementById("status").textContent =
          "No chat selected";

        return;

      }


      /* Cannot chat with yourself */

      if (partnerUid === currentUser.uid) {

        showNotice(
          "নিজের সাথে Chat করা যাবে না",
          "অন্য matched user নির্বাচন করুন।"
        );

        return;

      }


      chatId = makeChatId(
        currentUser.uid,
        partnerUid
      );


      document.getElementById("status").textContent =
        "Online chat";


      loadMessages();

    });


    /* =========================
       LOAD MESSAGES
    ========================= */

    function loadMessages() {

      const messagesRef = collection(
        db,
        "chats",
        chatId,
        "messages"
      );


      const messagesQuery = query(
        messagesRef,
        orderBy("createdAt", "asc")
      );


      unsubscribeMessages = onSnapshot(
        messagesQuery,

        (snapshot) => {

          const messagesBox =
            document.getElementById("messages");


          messagesBox.innerHTML = "";


          if (snapshot.empty) {

            const welcome =
              document.createElement("div");

            welcome.className = "welcome";

            welcome.innerHTML =
              "💗 Chat শুরু করুন<br><br>" +
              "প্রথম মেসেজটি পাঠান।";

            messagesBox.appendChild(welcome);

          }


          snapshot.forEach((doc) => {

            const data = doc.data();

            showMessage(data);

          });


          scrollToBottom();

        },

        (error) => {

          console.error(error);

          showNotice(
            "Chat Error",
            "Messages load করা যাচ্ছে না। Firestore Rules check করুন।"
          );

        }

      );

    }


    /* =========================
       SHOW MESSAGE
    ========================= */

    function showMessage(data) {

      const messagesBox =
        document.getElementById("messages");


      const row =
        document.createElement("div");


      const isMe =
        data.senderId === currentUser.uid;


      row.className =
        "message-row " +
        (isMe ? "me" : "other");


      const bubble =
        document.createElement("div");

      bubble.className = "message";


      const text =
        document.createElement("div");

      text.textContent =
        data.text || "";


      const time =
        document.createElement("div");

      time.className = "time";


      if (data.createdAt) {

        try {

          const date =
            data.createdAt.toDate();

          time.textContent =
            date.toLocaleTimeString(
              "bn-BD",
              {
                hour: "numeric",
                minute: "2-digit"
              }
            );

        } catch {

          time.textContent = "";

        }

      }


      bubble.appendChild(text);

      bubble.appendChild(time);

      row.appendChild(bubble);

      messagesBox.appendChild(row);

    }


    /* =========================
       SEND MESSAGE
    ========================= */

    async function sendMessage() {

      const input =
        document.getElementById("messageInput");


      const text =
        input.value.trim();


      if (!text) return;


      if (!currentUser) {

        alert("আগে Login করুন।");

        return;

      }


      if (!partnerUid) {

        alert("Chat user নির্বাচন করা হয়নি।");

        return;

      }


      if (!chatId) {

        alert("Chat room তৈরি হয়নি।");

        return;

      }


      const sendBtn =
        document.getElementById("sendBtn");


      sendBtn.disabled = true;


      try {

        await addDoc(

          collection(
            db,
            "chats",
            chatId,
            "messages"
          ),

          {

            text: text,

            senderId:
              currentUser.uid,

            receiverId:
              partnerUid,

            createdAt:
              serverTimestamp()

          }

        );


        input.value = "";

        input.focus();


      } catch (error) {

        console.error(error);

        alert(
          "Message পাঠানো যায়নি। Firestore Rules check করুন।"
        );

      }


      sendBtn.disabled = false;

    }


    /* =========================
       SEND BUTTON
    ========================= */

    document
      .getElementById("sendBtn")
      .addEventListener(
        "click",
        sendMessage
      );


    /* =========================
       ENTER TO SEND
    ========================= */

    document
      .getElementById("messageInput")
      .addEventListener(
        "keydown",
        (event) => {

          if (
            event.key === "Enter" &&
            !event.shiftKey
          ) {

            event.preventDefault();

            sendMessage();

          }

        }
      );


    /* =========================
       SCROLL
    ========================= */

    function scrollToBottom() {

      const box =
        document.getElementById("messages");


      setTimeout(() => {

        box.scrollTop =
          box.scrollHeight;

      }, 100);

    }


    /* =========================
       NOTICE
    ========================= */

    function showNotice(title, message) {

      const messages =
        document.getElementById("messages");


      messages.innerHTML = "";


      const div =
        document.createElement("div");


      div.className = "notice";


      div.innerHTML = `

        <h2>${title}</h2>

        <p>${message}</p>

        <button onclick="goBack()">
          ← Back
        </button>

      `;


      messages.appendChild(div);

    }

  </script>

</body>
</html>
