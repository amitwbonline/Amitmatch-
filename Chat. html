<!DOCTYPE html>
<html lang="bn">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <title>Amit Match - Chat</title>

  <style>
    * {
      box-sizing: border-box;
    }

    body {
      margin: 0;
      font-family: Arial, sans-serif;
      background: #fff5fa;
      color: #222;
    }

    .header {
      background: linear-gradient(135deg, #f72585, #9c27b0);
      color: white;
      padding: 18px;
      text-align: center;
      position: sticky;
      top: 0;
      z-index: 10;
    }

    .header h1 {
      margin: 0;
      font-size: 28px;
    }

    .back {
      display: inline-block;
      margin-top: 10px;
      color: white;
      text-decoration: none;
      background: rgba(255,255,255,.2);
      padding: 8px 18px;
      border-radius: 20px;
    }

    .chat-box {
      max-width: 700px;
      margin: 15px auto;
      background: white;
      min-height: calc(100vh - 140px);
      border-radius: 18px;
      box-shadow: 0 3px 15px rgba(0,0,0,.08);
      display: flex;
      flex-direction: column;
      overflow: hidden;
    }

    .person {
      padding: 15px;
      border-bottom: 1px solid #eee;
      font-size: 18px;
      font-weight: bold;
    }

    #messages {
      flex: 1;
      padding: 15px;
      overflow-y: auto;
      min-height: 400px;
    }

    .message {
      max-width: 75%;
      padding: 10px 14px;
      margin: 8px 0;
      border-radius: 18px;
      word-wrap: break-word;
      line-height: 1.4;
    }

    .mine {
      margin-left: auto;
      background: #e91e63;
      color: white;
      border-bottom-right-radius: 5px;
    }

    .other {
      margin-right: auto;
      background: #eeeeee;
      color: #222;
      border-bottom-left-radius: 5px;
    }

    .time {
      font-size: 10px;
      opacity: .7;
      margin-top: 4px;
    }

    .input-area {
      display: flex;
      gap: 8px;
      padding: 12px;
      border-top: 1px solid #eee;
      background: white;
    }

    #messageInput {
      flex: 1;
      border: 1px solid #ddd;
      border-radius: 25px;
      padding: 12px 16px;
      font-size: 16px;
      outline: none;
    }

    #sendBtn {
      border: none;
      background: linear-gradient(135deg, #f72585, #9c27b0);
      color: white;
      border-radius: 25px;
      padding: 0 20px;
      font-size: 16px;
      font-weight: bold;
      cursor: pointer;
    }

    #status {
      text-align: center;
      padding: 15px;
      color: #777;
    }

    @media(max-width:600px) {
      .chat-box {
        margin: 0;
        border-radius: 0;
      }

      .message {
        max-width: 82%;
      }
    }
  </style>
</head>

<body>

  <div class="header">
    <h1>💬 Amit Match Chat</h1>
    <a href="index.html" class="back">🏠 Home</a>
  </div>

  <div class="chat-box">

    <div class="person" id="personName">
      💕 Chat
    </div>

    <div id="status">
      Chat loading...
    </div>

    <div id="messages"></div>

    <div class="input-area">
      <input
        type="text"
        id="messageInput"
        placeholder="আপনার message লিখুন..."
        autocomplete="off"
      >

      <button id="sendBtn">
        Send
      </button>
    </div>

  </div>


<script type="module">

  // Firebase
  import { initializeApp }
    from "https://www.gstatic.com/firebasejs/10.12.2/firebase-app.js";

  import {
    getAuth,
    onAuthStateChanged
  } from "https://www.gstatic.com/firebasejs/10.12.2/firebase-auth.js";

  import {
    getFirestore,
    collection,
    addDoc,
    query,
    orderBy,
    onSnapshot,
    serverTimestamp
  } from "https://www.gstatic.com/firebasejs/10.12.2/firebase-firestore.js";


  // ==========================
  // FIREBASE CONFIG
  // ==========================

  const firebaseConfig = {
    apiKey: "AIzaSyAHKG7uIA3oQK5Syfq96xJW-lKbjihswl4",
    authDomain: "amit-match.firebaseapp.com",
    projectId: "amit-match",
    storageBucket: "amit-match.firebasestorage.app",
    messagingSenderId: "128100464896",
    appId: "1:128100464896:web:471c7a89502d1a6a679be5",
    measurementId: "G-F1P824DE41"
  };


  // Firebase শুরু
  const app = initializeApp(firebaseConfig);

  const auth = getAuth(app);

  const db = getFirestore(app);


  // ==========================
  // ELEMENTS
  // ==========================

  const messagesBox =
    document.getElementById("messages");

  const messageInput =
    document.getElementById("messageInput");

  const sendBtn =
    document.getElementById("sendBtn");

  const status =
    document.getElementById("status");

  const personName =
    document.getElementById("personName");


  // ==========================
  // GET OTHER USER ID
  // URL example:
  //
  // chat.html?uid=OTHER_USER_ID&name=Rahul
  // ==========================

  const params =
    new URLSearchParams(window.location.search);

  const otherUserId =
    params.get("uid");

  const otherUserName =
    params.get("name") || "User";


  personName.innerHTML =
    "💕 " + decodeURIComponent(otherUserName);


  // ==========================
  // CURRENT USER
  // ==========================

  let currentUser = null;


  onAuthStateChanged(auth, (user) => {

    if (!user) {

      status.innerHTML =
        "⚠️ আগে Login করুন।";

      sendBtn.disabled = true;

      return;
    }

    currentUser = user;

    status.innerHTML = "";

    if (!otherUserId) {

      status.innerHTML =
        "⚠️ Chat করার জন্য user নির্বাচন করুন।";

      sendBtn.disabled = true;

      return;
    }

    loadMessages();

  });


  // ==========================
  // CHAT ID
  // দুই user-এর জন্য একই chat ID
  // ==========================

  function getChatId(uid1, uid2) {

    return [uid1, uid2]
      .sort()
      .join("_");

  }


  // ==========================
  // LOAD MESSAGES
  // ==========================

  function loadMessages() {

    const chatId =
      getChatId(currentUser.uid, otherUserId);


    const messagesRef =
      collection(
        db,
        "chats",
        chatId,
        "messages"
      );


    const q =
      query(
        messagesRef,
        orderBy("createdAt", "asc")
      );


    onSnapshot(q, (snapshot) => {

      messagesBox.innerHTML = "";


      snapshot.forEach((doc) => {

        const data = doc.data();

        const div =
          document.createElement("div");


        div.classList.add("message");


        if (
          data.senderId === currentUser.uid
        ) {

          div.classList.add("mine");

        } else {

          div.classList.add("other");

        }


        const text =
          document.createElement("div");

        text.textContent =
          data.text || "";


        div.appendChild(text);


        if (data.createdAt) {

          const time =
            document.createElement("div");

          time.className = "time";

          const date =
            data.createdAt.toDate();

          time.textContent =
            date.toLocaleTimeString(
              "bn-BD",
              {
                hour: "2-digit",
                minute: "2-digit"
              }
            );

          div.appendChild(time);

        }


        messagesBox.appendChild(div);

      });


      messagesBox.scrollTop =
        messagesBox.scrollHeight;

    });

  }


  // ==========================
  // SEND MESSAGE
  // ==========================

  async function sendMessage() {

    const text =
      messageInput.value.trim();


    if (!text) return;


    if (!currentUser) {

      alert("আগে Login করুন।");

      return;

    }


    if (!otherUserId) {

      alert("যার সঙ্গে Chat করবেন তাকে নির্বাচন করুন।");

      return;

    }


    const chatId =
      getChatId(
        currentUser.uid,
        otherUserId
      );


    try {

      await addDoc(
        collection(
          db,
          "chats",
          chatId,
          "messages"
        ),
        {
          senderId: currentUser.uid,
          receiverId: otherUserId,
          text: text,
          createdAt: serverTimestamp()
        }
      );


      messageInput.value = "";

      messageInput.focus();

    } catch (error) {

      console.error(error);

      alert(
        "Message পাঠানো যায়নি। Firestore Rules পরীক্ষা করুন।"
      );

    }

  }


  sendBtn.addEventListener(
    "click",
    sendMessage
  );


  messageInput.addEventListener(
    "keydown",
    (event) => {

      if (event.key === "Enter") {

        sendMessage();

      }

    }
  );

</script>

</body>
</html>
