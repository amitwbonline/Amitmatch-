<!DOCTYPE html>
<html lang="bn">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Amit Match - Chat</title>

<style>
*{
  box-sizing:border-box;
}

body{
  margin:0;
  font-family:Arial,sans-serif;
  background:#fff5f9;
  color:#29252d;
}

.header{
  background:linear-gradient(135deg,#f72572,#a928bd);
  color:white;
  padding:16px;
  text-align:center;
  position:sticky;
  top:0;
  z-index:10;
}

.header h1{
  margin:0;
  font-size:26px;
}

.back{
  display:inline-block;
  margin-top:10px;
  color:white;
  text-decoration:none;
  font-size:16px;
}

.chat-box{
  max-width:700px;
  margin:15px auto;
  background:white;
  min-height:calc(100vh - 120px);
  border-radius:18px;
  box-shadow:0 3px 15px rgba(0,0,0,.12);
  display:flex;
  flex-direction:column;
  overflow:hidden;
}

.person{
  padding:15px;
  border-bottom:1px solid #eee;
  font-size:19px;
  font-weight:bold;
}

#messages{
  flex:1;
  padding:15px;
  overflow-y:auto;
  min-height:450px;
}

.message{
  max-width:78%;
  padding:11px 14px;
  margin:8px 0;
  border-radius:18px;
  word-wrap:break-word;
  line-height:1.4;
}

.me{
  margin-left:auto;
  background:#e91e63;
  color:white;
  border-bottom-right-radius:5px;
}

.other{
  margin-right:auto;
  background:#eeeeee;
  color:#222;
  border-bottom-left-radius:5px;
}

.time{
  font-size:11px;
  opacity:.7;
  display:block;
  margin-top:4px;
}

.empty{
  text-align:center;
  color:#888;
  padding-top:80px;
}

.input-area{
  display:flex;
  gap:8px;
  padding:12px;
  border-top:1px solid #ddd;
  background:white;
}

#messageInput{
  flex:1;
  border:1px solid #ddd;
  border-radius:25px;
  padding:13px 16px;
  font-size:16px;
  outline:none;
}

#sendBtn{
  border:0;
  background:linear-gradient(135deg,#f72572,#a928bd);
  color:white;
  border-radius:25px;
  padding:0 20px;
  font-size:16px;
  font-weight:bold;
}

#sendBtn:disabled{
  opacity:.5;
}

.status{
  text-align:center;
  font-size:13px;
  color:#777;
  padding:5px;
}

@media(max-width:600px){
  .chat-box{
    margin:0;
    border-radius:0;
    min-height:calc(100vh - 80px);
  }

  #messages{
    min-height:400px;
  }
}
</style>
</head>

<body>

<div class="header">
  <h1>💖 Amit Match Chat</h1>
  <a class="back" href="index.html">← Back to Amit Match</a>
</div>

<div class="chat-box">

  <div class="person" id="personName">
    💬 Chat
  </div>

  <div class="status" id="status">
    Connecting...
  </div>

  <div id="messages">
    <div class="empty">
      💬 কোনো মেসেজ নেই।<br>
      কথা বলা শুরু করুন ❤️
    </div>
  </div>

  <div class="input-area">
    <input
      type="text"
      id="messageInput"
      placeholder="আপনার মেসেজ লিখুন..."
      autocomplete="off"
    >
    <button id="sendBtn">Send</button>
  </div>

</div>

<script type="module">

import { initializeApp } from
"https://www.gstatic.com/firebasejs/10.12.2/firebase-app.js";

import {
  getAuth,
  onAuthStateChanged
} from
"https://www.gstatic.com/firebasejs/10.12.2/firebase-auth.js";

import {
  getFirestore,
  collection,
  addDoc,
  query,
  where,
  orderBy,
  onSnapshot,
  serverTimestamp
} from
"https://www.gstatic.com/firebasejs/10.12.2/firebase-firestore.js";


/* =========================
   FIREBASE CONFIG
========================= */

const firebaseConfig = {
  apiKey: "AIzaSyAHKG7uIA3oQK5Syfq96xJW-lKbjihswl4",
  authDomain: "amit-match.firebaseapp.com",
  projectId: "amit-match",
  storageBucket: "amit-match.firebasestorage.app",
  messagingSenderId: "128100464896",
  appId: "1:128100464896:web:471c7a89502d1a6a679be5",
  measurementId: "G-F1P824DE41"
};


/* =========================
   INITIALIZE FIREBASE
========================= */

const app = initializeApp(firebaseConfig);

const auth = getAuth(app);

const db = getFirestore(app);


/* =========================
   HTML ELEMENTS
========================= */

const messagesBox =
  document.getElementById("messages");

const messageInput =
  document.getElementById("messageInput");

const sendBtn =
  document.getElementById("sendBtn");

const personName =
  document.getElementById("personName");

const statusText =
  document.getElementById("status");


/* =========================
   GET CHAT USER FROM URL
=========================

Example:

Chat.html?uid=USER_ID&name=Rahul

*/

const params =
  new URLSearchParams(window.location.search);

const receiverId =
  params.get("uid");

const receiverName =
  params.get("name") || "User";


/* =========================
   SHOW PERSON NAME
========================= */

personName.innerHTML =
  "💬 " +
  decodeURIComponent(receiverName);


/* =========================
   CHECK RECEIVER
========================= */

if(!receiverId){

  statusText.innerText =
    "❌ Chat করার জন্য কোনো user নির্বাচন করা হয়নি।";

  sendBtn.disabled = true;

}


/* =========================
   CURRENT USER
========================= */

let currentUser = null;


/* =========================
   LOGIN CHECK
========================= */

onAuthStateChanged(auth, user => {

  if(!user){

    statusText.innerText =
      "❌ আগে Login করুন।";

    sendBtn.disabled = true;

    return;
  }

  currentUser = user;

  statusText.innerText =
    "🟢 Online";

  if(receiverId){

    loadMessages();
  }

});


/* =========================
   LOAD MESSAGES
========================= */

function loadMessages(){

  /*
    একই chat-এর message আনার জন্য
    দুই দিকের message query করা হচ্ছে।
  */

  const q1 = query(
    collection(db,"messages"),
    where("senderId","==",currentUser.uid),
    where("receiverId","==",receiverId),
    orderBy("createdAt","asc")
  );


  const q2 = query(
    collection(db,"messages"),
    where("senderId","==",receiverId),
    where("receiverId","==",currentUser.uid),
    orderBy("createdAt","asc")
  );


  let sentMessages = [];
  let receivedMessages = [];


  function showAll(){

    const allMessages =
      [...sentMessages,...receivedMessages];

    allMessages.sort((a,b)=>{

      const ta =
        a.createdAt?.toMillis?.() || 0;

      const tb =
        b.createdAt?.toMillis?.() || 0;

      return ta - tb;

    });


    messagesBox.innerHTML = "";


    if(allMessages.length === 0){

      messagesBox.innerHTML = `
        <div class="empty">
          💬 কোনো মেসেজ নেই।<br>
          কথা বলা শুরু করুন ❤️
        </div>
      `;

      return;
    }


    allMessages.forEach(msg => {

      const div =
        document.createElement("div");

      div.classList.add("message");


      if(msg.senderId === currentUser.uid){

        div.classList.add("me");

      }else{

        div.classList.add("other");

      }


      const time =
        msg.createdAt?.toDate
        ? msg.createdAt.toDate()
        : new Date();


      div.innerHTML = `
        ${escapeHTML(msg.text)}
        <span class="time">
          ${time.toLocaleTimeString(
            "bn-BD",
            {
              hour:"2-digit",
              minute:"2-digit"
            }
          )}
        </span>
      `;


      messagesBox.appendChild(div);

    });


    messagesBox.scrollTop =
      messagesBox.scrollHeight;

  }


  onSnapshot(q1, snapshot => {

    sentMessages =
      snapshot.docs.map(doc => ({
        id:doc.id,
        ...doc.data()
      }));

    showAll();

  });


  onSnapshot(q2, snapshot => {

    receivedMessages =
      snapshot.docs.map(doc => ({
        id:doc.id,
        ...doc.data()
      }));

    showAll();

  });

}


/* =========================
   SEND MESSAGE
========================= */

async function sendMessage(){

  if(!currentUser){

    alert("আগে Login করুন।");

    return;
  }


  if(!receiverId){

    alert("Receiver পাওয়া যায়নি।");

    return;
  }


  const text =
    messageInput.value.trim();


  if(!text){

    return;
  }


  sendBtn.disabled = true;


  try{

    await addDoc(
      collection(db,"messages"),
      {

        senderId:
          currentUser.uid,

        receiverId:
          receiverId,

        text:
          text,

        createdAt:
          serverTimestamp()

      }
    );


    messageInput.value = "";

  }catch(error){

    console.error(error);

    alert(
      "Message পাঠানো যায়নি। Firebase Rules চেক করুন।"
    );

  }


  sendBtn.disabled = false;

}


/* =========================
   SEND BUTTON
========================= */

sendBtn.addEventListener(
  "click",
  sendMessage
);


/* =========================
   ENTER KEY
========================= */

messageInput.addEventListener(
  "keydown",
  event => {

    if(event.key === "Enter"){

      event.preventDefault();

      sendMessage();

    }

  }
);


/* =========================
   SECURITY
========================= */

function escapeHTML(text){

  return text
    .replaceAll("&","&amp;")
    .replaceAll("<","&lt;")
    .replaceAll(">","&gt;")
    .replaceAll('"',"&quot;")
    .replaceAll("'","&#039;");

}

</script>

</body>
</html>
